    "content": "{\"name\": \"Implement Switchable Local Memory System\", \"trigger_keywords\": [\"memory\", \"storage\", \"sqlite\", \"markdown\", \"switch\", \"retrieve\", \"long-term\"], \"steps\": [\"Define environment variables for configuration (ENABLED, MODE, DIR, INDEX_DB)\", \"Create Markdown directory structure (MEMORY.md, experiences/*.md)\", \"Implement SQLite FTS5 index creation and sync logic with content hashing\", \"Add switch check at the entry point of retrieval function\", \"Implement context-aware retrieval timing logic (explicit request, pronouns, complexity)\", \"Execute search (BM25/Vector) and format results with file path and line numbers\", \"Add toggle tool for dynamic enabling/disabling\"], \"inputs\": [\"query\", \"context\", \"config_flags\", \"n_results\"], \"outputs\": [\"search_results\", \"citation_metadata\", \"status_message\"], \"constraints\": [\"Must support disable switch with graceful degradation\", \"Index must be rebuildable from Markdown files\", \"Results must include file path and line numbers for citation\", \"Interface signatures must remain backward compatible\"], \"tags\": [\"memory\", \"architecture\", \"sqlite\", \"markdown\", \"feature-toggle\"]}",
