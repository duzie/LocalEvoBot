# GNews API 配置
# 从 https://gnews.io/ 获取您的 API Key
GNEWS_API_KEY=your_gnews_api_key_here

# 其他可选配置
# 默认语言
GNEWS_DEFAULT_LANGUAGE=en

# 默认国家
GNEWS_DEFAULT_COUNTRY=us

# 默认最大结果数
GNEWS_DEFAULT_MAX_RESULTS=10

# WhatsApp 接入配置
#
# WA_PROVIDER 用于选择接入方式：
# - baileys: 使用本项目自带的网关（WhatsApp Web / Baileys，存在封号风险）
# - cloud: 使用官方 WhatsApp Business Platform（Cloud API）
WA_PROVIDER=baileys
#
# 通用（两种方式都会用到）
# - 是否允许 WhatsApp 私聊消息进入 Agent（1/0）
WA_DM_ENABLED=1
# - 允许的发送方白名单（E164 格式，如 +8613800138000），多个用逗号分隔；写 * 表示放行全部
WA_ALLOW_FROM=*

# WhatsApp（Baileys 网关模式）配置
#
# 网关 HTTP 监听地址与端口（main.py 会尝试访问 http://{host}:{port}/health）
WA_GATEWAY_HOST=127.0.0.1
WA_GATEWAY_PORT=8787
# 网关鉴权 Token（网关 /send、/qr 等接口会校验 Bearer Token）
WA_GATEWAY_TOKEN=change_me
# 是否自动启动内置网关（1/0）；当 WA_PROVIDER=cloud 时会自动忽略
WA_GATEWAY_AUTOSTART=0
# 启动网关使用的 node 可执行文件（如 node 或 node.exe 的完整路径）
WA_NODE_BIN=node
# 网关登录态存储目录（Baileys multi-file auth）
WA_AUTH_DIR=./gateway/auth
# 网关收到消息后转发到本项目 Webhook 的地址（示例：本机 Web 控制台默认端口 5010）
WA_WEBHOOK_URL=http://127.0.0.1:5010/api/chat/whatsapp/webhook
# Webhook 回调鉴权 Token（本项目会校验 Header: Authorization: Bearer <token>）
WA_WEBHOOK_TOKEN=
# 发送长消息时分片长度（字符数）
WA_TEXT_CHUNK_LIMIT=4000
# 是否在网关控制台打印二维码（1/0）
WA_PRINT_QR=1
# 网关代理（可选）
WA_PROXY_ENABLED=0
WA_PROXY_URL=

# WhatsApp（官方 Cloud API 模式）配置
#
# 说明：当 WA_PROVIDER=cloud 时，不需要启动 Baileys 网关，也不需要二维码登录。
# - 你需要在 Meta 开发者后台把 Webhook 指向：
#   GET/POST http(s)://<你的域名或公网IP>:5010/api/chat/whatsapp/cloud/webhook
#
#- WA_CLOUD_VERIFY_TOKEN ：Webhook 验证用的“口令”。你在 Meta 开发者后台配置 Webhook 时会填一个 Verify Token。Meta 会先对你的回调地址发一个 GET 请求，带上 hub.verify_token ，本项目会把它和 WA_CLOUD_VERIFY_TOKEN 比对；一致才回 hub.challenge ，Webhook 才算验证通过。对应代码在 chat.py 。
- WA_CLOUD_ACCESS_TOKEN ：调用官方 Graph API 发消息用的访问令牌（Bearer token）。当 Agent 要回复用户时，会用它请求 https://graph.facebook.com/{version}/{phone_number_id}/messages 把文本发回 WhatsApp。对应代码在 main.py 。
# Webhook 校验 token（Meta 验证 Webhook 时会带 hub.verify_token；需要与这里一致）
WA_CLOUD_VERIFY_TOKEN=change_me
# Graph API 访问令牌（Meta: WhatsApp Business Platform -> API 设置里生成/配置）
WA_CLOUD_ACCESS_TOKEN=change_me
# phone_number_id（Meta 分配的 Phone Number ID，用于发消息的 endpoint）
WA_CLOUD_PHONE_NUMBER_ID=change_me
# Graph API 版本（如 v19.0）
WA_CLOUD_API_VERSION=v19.0
# App Secret（可选）：用于校验 X-Hub-Signature-256（建议生产环境配置）
WA_CLOUD_APP_SECRET=

# 使用说明：
# 1. 复制此文件为 .env
# 2. 将占位符（change_me / your_gnews_api_key_here）替换为真实值
# 3. Web 控制台与 Agent 会自动从环境变量读取配置
